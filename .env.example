# ==========================================
# Application Configuration
# ==========================================
APP_NAME="Haisen Official Store"
APP_ENV=development
APP_PORT=8000
DEBUG=true
SECRET_KEY=haisen-store-ultra-secure-secret-key-replace-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# ==========================================
# Database (PostgreSQL / Supabase Async)
# ==========================================
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/haisen_store
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ==========================================
# Midtrans Payment Gateway
# ==========================================
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false

# ==========================================
# Email SMTP (Gmail)
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youremail@gmail.com
SMTP_PASSWORD=your-16-digit-gmail-app-password
MAIL_FROM=youremail@gmail.com
MAIL_FROM_NAME="Haisen Official Store"

# ==========================================
# WhatsApp Gateway (Self-Hosted Web QR Code)
# Khusus Notifikasi Superadmin, Admin, dan Staff
# ==========================================
WA_GATEWAY_URL=http://localhost:3333
WA_API_KEY=your-wa-engine-api-key
WA_ADMIN_NUMBERS=628123456789,628987654321

# ==========================================
# Object Storage (Supabase Storage S3-Compatible Bucket)
# Untuk Gambar Banner, Produk, Varian, dan Aset Digital
# ==========================================
S3_ENDPOINT_URL=https://<project-ref>.storage.supabase.co/storage/v1/s3
S3_ACCESS_KEY_ID=your-supabase-s3-access-key-id
S3_SECRET_ACCESS_KEY=your-supabase-s3-secret-access-key
S3_BUCKET_NAME=haisen-store-bucket
S3_REGION_NAME=ap-southeast-1
S3_PUBLIC_URL_PREFIX=https://<project-ref>.supabase.co/storage/v1/object/public/haisen-store-bucket

# ==========================================
# Frontend Application
# ==========================================
FRONTEND_URL=https://store.haisen.my.id

# ==========================================
# CORS Whitelist (Frontend)
# ==========================================
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://store.haisen.my.id
